{
  "$schema": "https://turborepo.com/schema.json",
  "remoteCache": { "signature": true },
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "public/**",
        "next.config.ts",
        "tsconfig.json",
        "package.json",
        "pnpm-lock.yaml",
        "!**/*unit-test.*",
        "!**/*end-to-end-test.*",
        "!**/*benchmark-test.*",
        "!**/snapshot/**"
      ],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "SITE_URL"]
    },
    "lint": { "inputs": ["src/**", "*.ts", "*.mjs", "eslint.config.mjs", "tsconfig.json"] },
    "format:check": {},
    "typecheck": { "inputs": ["src/**", "*.ts", "tsconfig.json", "next-env.d.ts"] },
    "test:unit": { "inputs": ["src/**", "vitest.config.ts", "tsconfig.json"] },
    "test:benchmark": { "inputs": ["src/**", "vitest.config.ts"], "cache": false },
    "test:end-to-end": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "public/**", "playwright.config.ts"],
      "outputs": ["test-results/**", "playwright-report/**"]
    },
    "docs": { "inputs": ["src/**", "typedoc.json", "tsconfig.json", "README.md"], "outputs": ["documentation/**"] },
    "dev": { "cache": false, "persistent": true },
    "start": { "cache": false, "persistent": true }
  }
}
