# Turborepo remote cache (local runs; Vercel builds get these from project environment variables)
TURBO_TOKEN=
TURBO_TEAM=sharadox
TURBO_REMOTE_CACHE_SIGNATURE_KEY=

# Contact form email server: Amazon SES over SMTP (credentials kept only in Vercel)
EMAIL_SERVER_HOST=email-smtp.eu-west-1.amazonaws.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USERNAME=
EMAIL_SERVER_PASSWORD=
# Sender, on the SES-verified sending subdomain
EMAIL_SENDER_ADDRESS=website@mail.sharadox.com
