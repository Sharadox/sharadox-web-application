# Turborepo remote cache (local runs; Vercel builds get these from project env vars)
TURBO_TOKEN=
TURBO_TEAM=sharadox
TURBO_REMOTE_CACHE_SIGNATURE_KEY=

# Contact form (AWS SES, IAM user limited to ses:SendEmail)
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Optional overrides
CONTACT_TO=
CONTACT_FROM=
