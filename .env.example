# Turborepo remote cache (local runs; Vercel builds get these from project environment variables)
TURBO_TOKEN=
TURBO_TEAM=sharadox
TURBO_REMOTE_CACHE_SIGNATURE_KEY=

# Contact form email server (Proton SMTP; the password is an SMTP token, kept only in Vercel)
EMAIL_SERVER_HOST=smtp.protonmail.ch
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USERNAME=
EMAIL_SERVER_PASSWORD=
