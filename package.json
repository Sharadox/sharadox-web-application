{
  "name": "@sharadox/sharadox-web-application",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "development": "next dev",
    "start": "next start",
    "build": "next build",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --coverage --passWithNoTests",
    "test:benchmark": "vitest bench --run --passWithNoTests",
    "test:end-to-end": "playwright test",
    "documentation": "typedoc",
    "verify": "turbo run format:check lint type-check test:unit test:benchmark build test:end-to-end",
    "prepare": "turborepo-configuration next-js-application && (husky || true)"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sharadox/es-lint-configuration-web-library": "^0.1.2",
    "@sharadox/next-js-configuration-web-library": "^0.1.2",
    "@sharadox/playwright-configuration-web-library": "^0.1.1",
    "@sharadox/prettier-configuration-web-library": "^0.1.1",
    "@sharadox/test-web-library": "^0.3.1",
    "@sharadox/turborepo-configuration-web-library": "^0.1.1",
    "@sharadox/type-script-configuration-web-library": "^0.2.1",
    "@sharadox/vitest-configuration-web-library": "^0.1.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "sass": "^1.108.2",
    "turbo": "^2.11.10",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "26.x"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{scss,css,json,md,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  },
  "license": "SEE LICENSE IN LICENCA.md",
  "dependencies": {
    "@sharadox/internationalization-web-library": "^0.2.3",
    "@sharadox/metadata-web-library": "^0.3.0",
    "@sharadox/pointer-web-library": "^0.1.1",
    "@sharadox/scroll-web-library": "^0.2.0",
    "@sharadox/sharadox-web-library": "^0.19.0",
    "@sharadox/style-web-library": "^0.2.1",
    "@sharadox/web-library": "^0.7.0",
    "geist": "^1.9.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
