{
  "name": "@sharadox/sharadox-web-application",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "development": "next dev",
    "start": "next start",
    "build": "next build",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "test:benchmark": "vitest bench --run --passWithNoTests",
    "test:end-to-end": "playwright test",
    "documentation": "typedoc",
    "verify": "turbo run format:check lint type-check test:unit test:benchmark build test:end-to-end",
    "prepare": "husky",
    "globe-points": "node src/script/globe-points/index.ts"
  },
  "dependencies": {
    "@sharadox/sharadox-web-library": "^0.5.0",
    "@sharadox/web-library": "^0.3.0",
    "geist": "^1.4.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.2.1",
    "d3-geo": "^3.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "topojson-client": "^3.1.0",
    "turbo": "^2.11.10",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{scss,css,json,md,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  },
  "license": "SEE LICENSE IN LICENCA.md"
}
